<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Персональный Электронный Дневник</title>
  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --bg: #f3f4f6;
      --card-bg: #ffffff;
      --text: #1f2937;
      --border: #e5e7eb;
      --danger: #ef4444;
      --warning: #f59e0b;
      --success: #10b981;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding: 20px; }
    .container { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 320px 1fr; gap: 20px; }

    /* Боковая панель */
    .sidebar { background: var(--card-bg); padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); height: fit-content; }
    .nav-tabs { display: flex; gap: 5px; margin-bottom: 15px; }
    .nav-tab { flex: 1; padding: 8px; text-align: center; background: #e5e7eb; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; }
    .nav-tab.active { background: var(--primary); color: white; }

    .calendar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; text-align: center; }
    .calendar-day-head { font-weight: bold; font-size: 12px; color: #6b7280; padding: 5px 0; }
    .calendar-day { padding: 8px 0; font-size: 14px; border-radius: 6px; cursor: pointer; border: 1px solid transparent; }
    .calendar-day:hover { background: #e0e7ff; }
    .calendar-day.active { background: var(--primary); color: white; font-weight: bold; }
    .calendar-day.customized { border-bottom: 3px solid var(--warning); }

    /* Селектор дней для Редактора Шаблона */
    .template-days-selector { display: flex; flex-direction: column; gap: 6px; }
    .template-day-btn { padding: 10px; border: 1px solid var(--border); border-radius: 6px; background: #f9fafb; cursor: pointer; text-align: left; font-weight: 600; }
    .template-day-btn.active { background: #e0e7ff; border-color: var(--primary); color: var(--primary); }

    /* Аналитика */
    .analytics { margin-top: 25px; border-top: 1px solid var(--border); padding-top: 15px; }
    .stat-card { background: #f9fafb; padding: 10px; border-radius: 8px; margin-top: 10px; }
    .subject-avg { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }

    /* Основная зона */
    .main-content { background: var(--card-bg); padding: 25px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    .header-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px; }
    
    .status-badge { font-size: 12px; padding: 4px 8px; border-radius: 4px; font-weight: 600; }
    .badge-template { background: #e0e7ff; color: #3730a3; }
    .badge-custom { background: #fef3c7; color: #92400e; }

    .lesson-card { 
      display: grid; 
      grid-template-columns: 40px 1.5fr 1fr 2fr 100px 40px; 
      gap: 10px; 
      align-items: center; 
      background: #f9fafb; 
      padding: 12px; 
      border-radius: 8px; 
      margin-bottom: 10px; 
      border: 1px solid var(--border);
    }

    input {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 14px;
    }
    input:focus { outline: 2px solid var(--primary); border-color: transparent; }

    .btn {
      padding: 8px 16px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      transition: 0.2s;
    }
    .btn:hover { background: var(--primary-hover); }
    .btn-danger { background: var(--danger); padding: 8px; }
    .btn-warning { background: var(--warning); color: white; }
    .btn-success { background: var(--success); color: white; }
    .btn-secondary { background: #6b7280; }

    /* Панель «Применить к» */
    .apply-bar {
      display: flex;
      gap: 8px;
      background: #f3f4f6;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 15px;
      align-items: center;
      flex-wrap: wrap;
    }
    .apply-bar label { font-weight: 600; font-size: 13px; color: #4b5563; }

    .tools { margin-top: 20px; display: flex; gap: 10px; border-top: 1px solid var(--border); padding-top: 15px; flex-wrap: wrap; }

    @media (max-width: 900px) {
      .container { grid-template-columns: 1fr; }
      .lesson-card { grid-template-columns: 1fr; gap: 8px; }
    }
  </style>
</head>
<body>

<div class="container">
  <!-- Боковая панель -->
  <div class="sidebar">
    <div class="nav-tabs">
      <div class="nav-tab active" id="tabCalendar" onclick="switchMode('calendar')">📅 Дневник</div>
      <div class="nav-tab" id="tabTemplate" onclick="switchMode('template')">⚙️ Шаблон</div>
    </div>

    <!-- Виджет 1: Календарь -->
    <div id="calendarView">
      <div class="calendar-header">
        <button class="btn btn-secondary" onclick="changeMonth(-1)">&lt;</button>
        <h3 id="monthTitle">Месяц Год</h3>
        <button class="btn btn-secondary" onclick="changeMonth(1)">&gt;</button>
      </div>
      <div class="calendar-grid" id="calendarGrid"></div>
    </div>

    <!-- Виджет 2: Выбор дня недели -->
    <div id="templateView" style="display: none;">
      <p style="font-size: 13px; color: #6b7280; margin-bottom: 10px;">Выбери день недели для настройки базового расписания:</p>
      <div class="template-days-selector">
        <div class="template-day-btn active" onclick="selectTemplateDay(1)">Понедельник</div>
        <div class="template-day-btn" onclick="selectTemplateDay(2)">Вторник</div>
        <div class="template-day-btn" onclick="selectTemplateDay(3)">Среда</div>
        <div class="template-day-btn" onclick="selectTemplateDay(4)">Четверг</div>
        <div class="template-day-btn" onclick="selectTemplateDay(5)">Пятница</div>
        <div class="template-day-btn" onclick="selectTemplateDay(6)">Суббота</div>
        <div class="template-day-btn" onclick="selectTemplateDay(0)">Воскресенье</div>
      </div>
    </div>

    <!-- Аналитика -->
    <div class="analytics">
      <h4>📊 Успеваемость</h4>
      <div class="stat-card">
        <div>Общий средний балл: <b id="totalAvg">0.00</b></div>
      </div>
      <div id="subjectStats" style="margin-top: 10px;"></div>
    </div>
  </div>

  <!-- Главная зона -->
  <div class="main-content">
    <div class="header-actions">
      <div>
        <h2 id="selectedDateTitle">Расписание</h2>
        <span id="dayStatusBadge" class="status-badge badge-template">Шаблон недели</span>
      </div>
      <div style="display: flex; gap: 8px;">
        <button class="btn btn-warning" id="resetBtn" onclick="resetDayToTemplate()" style="display:none;">Сбросить к шаблону</button>
        <button class="btn" onclick="addLesson()">+ Добавить урок</button>
      </div>
    </div>

    <!-- Панель быстрых действий шаблона -->
    <div class="apply-bar" id="applyBar" style="display: none;">
      <label>Применить этот шаблон:</label>
      <button class="btn btn-success" onclick="applyTemplate('all')">Ко всем дням</button>
      <button class="btn btn-success" onclick="applyTemplate('month')">К текущему месяцу</button>
      <button class="btn btn-success" onclick="applyTemplate('week')">К этой неделе</button>
      <button class="btn btn-success" onclick="applyTemplate('specific')">К определённой дате</button>
    </div>

    <div id="lessonsContainer"></div>

    <div class="tools">
      <button class="btn btn-secondary" onclick="exportData()">💾 Сохранить бэкап (JSON)</button>
      <button class="btn btn-secondary" onclick="importData()">📂 Загрузить бэкап</button>
      <input type="file" id="importFile" style="display:none" onchange="processImport(event)">
    </div>
  </div>
</div>

<script>
  let mode = 'calendar';
  let currentDate = new Date();
  let selectedDateStr = formatDate(new Date());
  let selectedTemplateDay = 1;

  let db = JSON.parse(localStorage.getItem('my_personal_diary_v4')) || {
    weeklyTemplate: { 1: [], 2: [], 3: [], 4: [], 5: [], 6: [], 0: [] },
    customDays: {} 
  };

  const monthNames = ["Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"];
  const weekDays = ["Воскресенье", "Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота"];

  function formatDate(d) {
    let month = '' + (d.getMonth() + 1);
    let day = '' + d.getDate();
    let year = d.getFullYear();
    if (month.length < 2) month = '0' + month;
    if (day.length < 2) day = '0' + day;
    return [year, month, day].join('-');
  }

  function getDayOfWeek(dateStr) {
    const parts = dateStr.split('-');
    return new Date(parts[0], parts[1] - 1, parts[2]).getDay();
  }

  function isCustomized(dateStr) {
    return db.customDays.hasOwnProperty(dateStr);
  }

  function switchMode(newMode) {
    mode = newMode;
    document.getElementById('tabCalendar').className = mode === 'calendar' ? 'nav-tab active' : 'nav-tab';
    document.getElementById('tabTemplate').className = mode === 'template' ? 'nav-tab active' : 'nav-tab';

    document.getElementById('calendarView').style.display = mode === 'calendar' ? 'block' : 'none';
    document.getElementById('templateView').style.display = mode === 'template' ? 'block' : 'none';
    document.getElementById('applyBar').style.display = mode === 'template' ? 'flex' : 'none';

    if (mode === 'calendar') {
      selectDate(selectedDateStr);
    } else {
      selectTemplateDay(selectedTemplateDay);
    }
  }

  function selectTemplateDay(dayNum) {
    selectedTemplateDay = dayNum;
    
    const buttons = document.querySelectorAll('.template-day-btn');
    const dayIndices = [1, 2, 3, 4, 5, 6, 0];
    buttons.forEach((btn, idx) => {
      btn.className = dayIndices[idx] === dayNum ? 'template-day-btn active' : 'template-day-btn';
    });

    document.getElementById('selectedDateTitle').innerText = `Шаблон: ${weekDays[dayNum]}`;
    const badge = document.getElementById('dayStatusBadge');
    badge.innerText = "Редактирование базового дня";
    badge.className = "status-badge badge-template";
    document.getElementById('resetBtn').style.display = "none";

    renderLessons();
  }

  function initCalendar() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    
    document.getElementById('monthTitle').innerText = `${monthNames[month]} ${year}`;
    
    const grid = document.getElementById('calendarGrid');
    grid.innerHTML = '';

    const daysHead = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
    daysHead.forEach(d => grid.innerHTML += `<div class="calendar-day-head">${d}</div>`);

    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    
    let startingIndex = firstDay === 0 ? 6 : firstDay - 1;

    for (let i = 0; i < startingIndex; i++) {
      grid.innerHTML += `<div></div>`;
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const dateObj = new Date(year, month, day);
      const dateStr = formatDate(dateObj);
      
      const isSelected = dateStr === selectedDateStr ? 'active' : '';
      const isCustom = isCustomized(dateStr) ? 'customized' : '';

      grid.innerHTML += `
        <div class="calendar-day ${isSelected} ${isCustom}" onclick="selectDate('${dateStr}')">
          ${day}
        </div>
      `;
    }
  }

  function changeMonth(delta) {
    currentDate.setMonth(currentDate.getMonth() + delta);
    initCalendar();
  }

  function selectDate(dateStr) {
    selectedDateStr = dateStr;
    const dayOfWeek = getDayOfWeek(dateStr);
    
    document.getElementById('selectedDateTitle').innerText = `${selectedDateStr} (${weekDays[dayOfWeek]})`;
    
    const badge = document.getElementById('dayStatusBadge');
    const resetBtn = document.getElementById('resetBtn');

    if (isCustomized(dateStr)) {
      badge.innerText = "Изменен вручную";
      badge.className = "status-badge badge-custom";
      resetBtn.style.display = "inline-block";
    } else {
      badge.innerText = "Основное расписание недели";
      badge.className = "status-badge badge-template";
      resetBtn.style.display = "none";
    }

    initCalendar();
    renderLessons();
  }

  function getCurrentLessons() {
    if (mode === 'template') {
      return db.weeklyTemplate[selectedTemplateDay] || [];
    } else {
      if (isCustomized(selectedDateStr)) {
        return db.customDays[selectedDateStr];
      }
      const dayOfWeek = getDayOfWeek(selectedDateStr);
      return db.weeklyTemplate[dayOfWeek] || [];
    }
  }

  function renderLessons() {
    const container = document.getElementById('lessonsContainer');
    container.innerHTML = '';

    const lessons = getCurrentLessons();

    if (lessons.length === 0) {
      container.innerHTML = `<p style="color: #9ca3af; text-align: center; padding: 20px;">На этот день нет уроков. Нажми "+ Добавить урок".</p>`;
    }

    lessons.forEach((lesson, index) => {
      container.innerHTML += `
        <div class="lesson-card">
          <span style="font-weight: bold; text-align: center;">#${index + 1}</span>
          <input type="text" value="${lesson.title || ''}" placeholder="Предмет" onchange="updateLesson(${index}, 'title', this.value)">
          <input type="text" value="${lesson.info || ''}" placeholder="Время / Кабинет" onchange="updateLesson(${index}, 'info', this.value)">
          <input type="text" value="${lesson.hw || ''}" placeholder="Домашнее задание" onchange="updateLesson(${index}, 'hw', this.value)">
          <input type="text" value="${lesson.mark || ''}" placeholder="Оценка" onchange="updateLesson(${index}, 'mark', this.value)">
          <button class="btn btn-danger" onclick="deleteLesson(${index})">✕</button>
        </div>
      `;
    });

    calculateAnalytics();
  }

  /* Логика кнопок «Применить к» */
  function applyTemplate(type) {
    const currentTemplate = JSON.parse(JSON.stringify(db.weeklyTemplate[selectedTemplateDay] || []));

    if (type === 'all') {
      // Сбрасываем все ручные переопределения для этого дня недели, чтобы вступил в силу глобальный шаблон
      Object.keys(db.customDays).forEach(dateStr => {
        if (getDayOfWeek(dateStr) === selectedTemplateDay) {
          delete db.customDays[dateStr];
        }
      });
      alert(`Шаблон (${weekDays[selectedTemplateDay]}) успешно применён ко всем соответствующим дням в календаре!`);
    } 
    else if (type === 'month') {
      const year = currentDate.getFullYear();
      const month = currentDate.getMonth();
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      for (let day = 1; day <= daysInMonth; day++) {
        const d = new Date(year, month, day);
        if (d.getDay() === selectedTemplateDay) {
          const dateStr = formatDate(d);
          db.customDays[dateStr] = JSON.parse(JSON.stringify(currentTemplate));
        }
      }
      alert(`Шаблон применён ко всем соответствующим дням в текущем месяце!`);
    } 
    else if (type === 'week') {
      const today = new Date(selectedDateStr);
      const dayOfWeek = today.getDay();
      const distanceToSelectedDay = selectedTemplateDay - dayOfWeek;
      const targetDate = new Date(today);
      targetDate.setDate(today.getDate() + distanceToSelectedDay);

      const targetDateStr = formatDate(targetDate);
      db.customDays[targetDateStr] = JSON.parse(JSON.stringify(currentTemplate));
      alert(`Шаблон применён к ${targetDateStr}!`);
    } 
    else if (type === 'specific') {
      const targetDateStr = prompt("Введите дату в формате ГГГГ-ММ-ДД (например, 2026-09-15):", selectedDateStr);
      if (targetDateStr) {
        db.customDays[targetDateStr] = JSON.parse(JSON.stringify(currentTemplate));
        alert(`Шаблон успешно записан на ${targetDateStr}!`);
      }
    }

    saveData();
  }

  function makeDateCustomIfNeeded() {
    if (mode === 'calendar' && !isCustomized(selectedDateStr)) {
      const dayOfWeek = getDayOfWeek(selectedDateStr);
      db.customDays[selectedDateStr] = JSON.parse(JSON.stringify(db.weeklyTemplate[dayOfWeek] || []));
    }
  }

  function addLesson() {
    if (mode === 'template') {
      if (!db.weeklyTemplate[selectedTemplateDay]) db.weeklyTemplate[selectedTemplateDay] = [];
      db.weeklyTemplate[selectedTemplateDay].push({ title: '', info: '', hw: '', mark: '' });
    } else {
      makeDateCustomIfNeeded();
      db.customDays[selectedDateStr].push({ title: '', info: '', hw: '', mark: '' });
    }
    saveData();
  }

  function updateLesson(index, field, value) {
    if (mode === 'template') {
      db.weeklyTemplate[selectedTemplateDay][index][field] = value;
    } else {
      makeDateCustomIfNeeded();
      db.customDays[selectedDateStr][index][field] = value;
    }
    saveData();
  }

  function deleteLesson(index) {
    if (mode === 'template') {
      db.weeklyTemplate[selectedTemplateDay].splice(index, 1);
    } else {
      makeDateCustomIfNeeded();
      db.customDays[selectedDateStr].splice(index, 1);
    }
    saveData();
  }

  function resetDayToTemplate() {
    if (confirm("Сбросить изменения для этого дня и вернуть основной шаблон недели?")) {
      delete db.customDays[selectedDateStr];
      saveData();
    }
  }

  function saveData() {
    localStorage.setItem('my_personal_diary_v4', JSON.stringify(db));
    if (mode === 'calendar') {
      selectDate(selectedDateStr);
    } else {
      selectTemplateDay(selectedTemplateDay);
    }
  }

  function calculateAnalytics() {
    let totalMarks = [];
    let subjectMarks = {};

    Object.values(db.customDays).forEach(dayLessons => {
      dayLessons.forEach(lesson => {
        if (lesson.title && lesson.mark) {
          const numMark = parseFloat(lesson.mark);
          if (!isNaN(numMark)) {
            totalMarks.push(numMark);
            if (!subjectMarks[lesson.title]) subjectMarks[lesson.title] = [];
            subjectMarks[lesson.title].push(numMark);
          }
        }
      });
    });

    const totalAvg = totalMarks.length ? (totalMarks.reduce((a, b) => a + b, 0) / totalMarks.length).toFixed(2) : '0.00';
    document.getElementById('totalAvg').innerText = totalAvg;

    const subjectStatsContainer = document.getElementById('subjectStats');
    subjectStatsContainer.innerHTML = '';

    Object.keys(subjectMarks).forEach(sub => {
      const avg = (subjectMarks[sub].reduce((a, b) => a + b, 0) / subjectMarks[sub].length).toFixed(2);
      subjectStatsContainer.innerHTML += `
        <div class="subject-avg">
          <span>${sub}</span>
          <b>${avg}</b>
        </div>
      `;
    });
  }

  function exportData() {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(db));
    const downloadAnchor = document.createElement('a');
    downloadAnchor.setAttribute("href", dataStr);
    downloadAnchor.setAttribute("download", `diary_backup_${selectedDateStr}.json`);
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
  }

  function importData() {
    document.getElementById('importFile').click();
  }

  function processImport(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        db = JSON.parse(e.target.result);
        saveData();
        alert('Данные успешно загружены!');
      } catch (err) {
        alert('Ошибка при чтении файла бэкапа');
      }
    };
    reader.readAsText(file);
  }

  selectDate(selectedDateStr);
</script>

</body>
</html>
